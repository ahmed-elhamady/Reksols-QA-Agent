{
  "name": "ui-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI automation framework foundation. Locators, environment URL, and feature tests are added later from QA artifacts.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
